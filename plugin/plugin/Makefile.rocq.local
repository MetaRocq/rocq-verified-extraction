INSTALLDEFAULTROOT=Malfunction/Plugin
CAMLFLAGS+=-open Metarocq_template_plugin
CAMLFLAGS+=-w -20 # Unused arguments
CAMLFLAGS+=-w -33 # Unused opens
CAMLFLAGS+=-w -32 # Unused values
CAMLFLAGS+=-w -8 # Non-exhaustive pattern-matching (due to comparison -> int translation)
CAMLFLAGS+=-w -26 # Unused variables
CAMLFLAGS+=-w -34 # Unused types
CAMLFLAGS+=-w -39 # Unused rec flags
CAMLFLAGS+=-w -56 # Unreachable case
CAMLFLAGS+=-w -60 # Unused module in functor
CAMLPKGS+=-package rocq-metarocq-template-ocaml.plugin,rocq_verified_extraction.plugin,stdlib-shims
